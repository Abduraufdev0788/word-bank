# ==============================================================================
# SmartVocab AI — Muhit o'zgaruvchilari shabloni (.env.example)
# Barcha maxfiy kalitlarni o'zingizning haqiqiy qiymatlaringiz bilan almashtiring.
# Hech qachon haqiqiy .env faylini git repozitoriyaga commit qilmang!
# ==============================================================================

# --- Umumiy loyiha sozlamalari ---
PROJECT_NAME="SmartVocab AI"
ENVIRONMENT="development" # development | staging | production
DEBUG=True
APP_URL="http://localhost:5173"
API_V1_PREFIX="/api/v1"

# --- Ma'lumotlar bazasi (PostgreSQL) ---
POSTGRES_USER="smartvocab_user"
POSTGRES_PASSWORD="strong_password_here"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="smartvocab_db"
# Asinxron ulanish satri (SQLAlchemy asyncpg)
DATABASE_URL="postgresql+asyncpg://smartvocab_user:strong_password_here@localhost:5432/smartvocab_db"

# --- Xavfsizlik va Autentifikatsiya (JWT) ---
# Tasodifiy kuchli kalit hosil qilish: openssl rand -hex 32
SECRET_KEY="replace_with_a_super_secret_cryptographic_key_at_least_32_chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60 # 1 soat
REFRESH_TOKEN_EXPIRE_DAYS=14   # 14 kun

# --- CORS sozlamalari (vergul bilan ajratilgan) ---
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# --- Google Gemini AI Integratsiyasi ---
# Google AI Studio orqali olingan API kalit
GEMINI_API_KEY="your_google_gemini_api_key_here"
# Tavsiya etilgan model (AGENTS.md qoidasiga binoan muhit o'zgaruvchisi orqali boshqariladi)
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# --- Telegram Bot Sozlamalari ---
# @BotFather orqali olingan token
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_BOT_USERNAME="SmartVocabAIBot"
TELEGRAM_LINK_TOKEN_EXPIRE_MINUTES=15 # Bog'lash tokenining amal qilish muddati
BACKEND_INTERNAL_API_URL="http://localhost:8000/api/v1"

# --- O'rganish va Faollikni kuzatish sozlamalari ---
STUDY_SESSION_IDLE_TIMEOUT_MINUTES=5 # Necha daqiqa harakatsiz qolsa sessiya to'xtatiladi
STUDY_HEARTBEAT_INTERVAL_SECONDS=30  # Har necha soniyada brauzerdan heartbeat yuboriladi
MAX_WORDS_PER_BATCH=20              # Bitta to'plamdagi maksimal so'zlar soni
DEFAULT_DAILY_WORDS_GOAL=10         # Kunlik yangi so'z maqsadi
DEFAULT_DAILY_STUDY_TIME_MINUTES=20 # Kunlik o'rganish vaqti maqsadi (daqiqa)
